{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "es2020"],
    "module": "esnext",
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "incremental": true,
    "jsx": "preserve",
    "paths": {
      "docs/*": ["./*"],
      "@mui/internal-core-docs": [
        "./vendor/mui-internal-core-docs/src/index.ts"
      ],
      "@mui/internal-core-docs/*": [
        "./vendor/mui-internal-core-docs/src/*/index.ts"
      ],
      "@mui/internal-core-docs/ApiPage/private": [
        "./vendor/mui-internal-core-docs/src/ApiPage/private.ts"
      ],
      "@mui/internal-markdown": ["./vendor/mui-internal-markdown/index.mjs"],
      "@mui/internal-markdown/*": ["./vendor/mui-internal-markdown/*"],
      "@open-ui-kit/core": ["./src/open-ui-kit-core-docs.ts"],
      "@open-ui-kit/core/typography.css": [
        "../packages/open-ui-kit/src/typography.css"
      ],
      "@/*": ["../packages/open-ui-kit/src/*"]
    },
    "strict": false
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "types",
    "src",
    "pages",
    "data",
    "vendor"
  ],
  "exclude": ["docs/.next", "docs/export", "node_modules"]
}
