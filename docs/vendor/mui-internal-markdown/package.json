{
  "name": "@mui/internal-markdown",
  "version": "3.0.8",
  "author": "Open UI Kit maintainers",
  "description": "Open UI Kit markdown parser. This is an internal package not meant for general use.",
  "main": "./index.mjs",
  "browser": "./index.mjs",
  "types": "./index.d.mts",
  "exports": {
    ".": "./index.mjs",
    "./loader": "./loader.mjs",
    "./prism": {
      "types": "./prism.d.mts",
      "require": null,
      "import": "./prism.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outshift-open/open-ui-kit.git",
    "directory": "docs/vendor/mui-internal-markdown"
  },
  "scripts": {
    "release:publish": "pnpm publish --tag latest",
    "release:publish:dry-run": "pnpm publish --tag latest --registry=\"http://localhost:4873/\""
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "es-toolkit": "^1.46.1",
    "marked": "^18.0.3",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@types/chai": "5.2.3",
    "chai": "6.2.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
