{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@open-ui-kit/monorepo",
  "version": "0.1.0",
  "description": "Open UI Kit - A comprehensive React component library and design system built on Material-UI",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/outshift-open/open-ui-kit.git"
  },
  "bugs": {
    "url": "https://github.com/outshift-open/open-ui-kit/issues"
  },
  "homepage": "https://github.com/outshift-open/open-ui-kit#readme",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "material-ui",
    "typescript",
    "open-source"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@open-ui-kit/core --filter=docs --filter=vite-ts",
    "start": "turbo run start --filter=@open-ui-kit/core --filter=docs --filter=vite-ts",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch --filter=@open-ui-kit/core",
    "check": "turbo run lint typecheck test",
    "lib:dev": "turbo run lib:dev --filter=@open-ui-kit/core",
    "lib:build": "turbo run lib:build --filter=@open-ui-kit/core",
    "core:dev": "yarn workspace @open-ui-kit/core dev",
    "core:build": "yarn workspace @open-ui-kit/core build",
    "core:lint": "yarn workspace @open-ui-kit/core lint",
    "core:typecheck": "yarn workspace @open-ui-kit/core typecheck",
    "core:test": "yarn workspace @open-ui-kit/core test",
    "docs": "yarn docs:dev",
    "docs:dev": "yarn workspace docs dev",
    "docs:build": "yarn workspace docs build",
    "docs:start": "yarn workspace docs start",
    "docs:typecheck": "yarn workspace docs typecheck",
    "storybook": "yarn workspace @open-ui-kit/core storybook",
    "storybook:build": "yarn workspace @open-ui-kit/core storybook:build",
    "license:add": "turbo run license:add --filter=@open-ui-kit/scripts && yarn prettier:fix",
    "license:add:force": "turbo run license:add:force --filter=@open-ui-kit/scripts && yarn prettier:fix",
    "license:check": "turbo run license:check --filter=@open-ui-kit/scripts",
    "prettier": "prettier --check --ignore-unknown \"**/*.{js,jsx,ts,tsx,mjs,cjs,md,mdx,json,yml,yaml,css,html}\"",
    "prettier:fix": "prettier --write --ignore-unknown \"**/*.{js,jsx,ts,tsx,mjs,cjs,md,mdx,json,yml,yaml,css,html}\"",
    "lint-staged": "lint-staged",
    "prepublish": "yarn build",
    "prepare": "husky",
    "semantic-release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.0.3",
    "semantic-release": "^24.2.0",
    "turbo": "^2.9.15"
  },
  "resolutions": {
    "@babel/plugin-transform-modules-systemjs": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@npmcli/package-json@npm:^7.0.0": "7.0.5",
    "ajv@npm:^6.12.4": "6.15.0",
    "axios": "1.17.0",
    "basic-ftp": "6.0.1",
    "bn.js@npm:^4.0.0": "4.12.3",
    "bn.js@npm:^4.1.0": "4.12.3",
    "bn.js@npm:^5.2.1": "5.2.3",
    "brace-expansion@npm:^1.1.7": "1.1.15",
    "brace-expansion@npm:^2.0.1": "2.1.1",
    "brace-expansion@npm:^5.0.5": "5.0.6",
    "esbuild": "0.25.12",
    "flatted": "3.4.2",
    "glob@npm:^10.2.2": "10.5.0",
    "glob@npm:^10.3.10": "10.5.0",
    "glob@npm:^10.4.5": "10.5.0",
    "glob@npm:^11.0.3": "11.1.0",
    "handlebars": "^4.7.9",
    "ip-address": "10.2.0",
    "joi": "18.2.1",
    "js-yaml@npm:^3.13.1": "3.14.2",
    "js-yaml@npm:^4.1.0": "4.1.1",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "minimatch@npm:^3.0.4": "3.1.4",
    "minimatch@npm:^3.0.5": "3.1.4",
    "minimatch@npm:^3.1.1": "3.1.4",
    "minimatch@npm:^8.0.2": "8.0.7",
    "minimatch@npm:^10.0.3": "10.2.5",
    "minimatch@npm:^10.1.1": "10.2.5",
    "minimatch@npm:^10.2.2": "10.2.5",
    "minimatch@npm:^10.2.5": "10.2.5",
    "minimatch@npm:^9.0.4": "9.0.9",
    "minimatch@npm:^9.0.5": "9.0.9",
    "npm@npm:^10.9.3": "11.17.0",
    "picomatch@npm:^2.0.4": "2.3.2",
    "picomatch@npm:^2.2.1": "2.3.2",
    "picomatch@npm:^2.2.3": "2.3.2",
    "picomatch@npm:^4.0.3": "4.0.4",
    "postcss": "8.5.15",
    "prismjs": "1.30.0",
    "rollup@npm:^4.20.0": "4.61.1",
    "rollup@npm:^4.34.9": "4.61.1",
    "semver": "7.7.4",
    "svgo@npm:^2.7.0": "2.8.2",
    "svgo@npm:^3.0.2": "3.3.3",
    "tar@npm:^7.4.3": "7.5.16",
    "ws": "8.21.0",
    "yaml": "1.10.3"
  },
  "workspaces": [
    "docs",
    "packages/*",
    "playground/*",
    "scripts"
  ],
  "packageManager": "yarn@4.15.0",
  "engines": {
    "node": ">=18"
  }
}
