{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@open-ui-kit/core",
  "version": "2.0.0-beta.10",
  "description": "A comprehensive React component library built on Material-UI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outshift-open/open-ui-kit.git"
  },
  "bugs": {
    "url": "https://github.com/outshift-open/open-ui-kit/issues"
  },
  "homepage": "https://github.com/outshift-open/open-ui-kit/tree/main/packages/open-ui-kit#readme",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "material-ui",
    "typescript",
    "open-source"
  ],
  "files": [
    "src/",
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "browser": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./*.css": "./dist/*.css",
    ".": {
      "node": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.esm.js",
        "require": "./dist/index.cjs.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.esm.js",
        "default": "./dist/index.umd.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "yarn lib:dev",
    "bundle": "rollup -c rollup.config.mjs",
    "build": "yarn lib:build",
    "lib:build": "yarn bundle",
    "dev": "yarn lib:dev",
    "lib:dev": "yarn bundle --watch",
    "format": "prettier --write --ignore-unknown \"{src,.storybook}/**/*.{js,jsx,ts,tsx,md,mdx,json,css}\" \"*.{js,mjs,cjs,ts,tsx,json,md,mdx}\"",
    "format:check": "prettier --check --ignore-unknown \"{src,.storybook}/**/*.{js,jsx,ts,tsx,md,mdx,json,css}\" \"*.{js,mjs,cjs,ts,tsx,json,md,mdx}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \".storybook/**/*.{ts,tsx}\" \"vitest.config.ts\" \"vitest.shims.d.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \".storybook/**/*.{ts,tsx}\" \"vitest.config.ts\" \"vitest.shims.d.ts\" --max-warnings=0 --fix",
    "typecheck": "yarn typecheck:src && yarn typecheck:storybook",
    "typecheck:src": "tsc --noEmit -p tsconfig.json",
    "typecheck:storybook": "tsc --noEmit -p tsconfig.storybook.json",
    "test": "jest --config=jest.config.js --coverage",
    "test:watch": "jest --config=jest.config.js --watch",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "NODE_OPTIONS=--max-old-space-size=4096 storybook build"
  },
  "peerDependencies": {
    "@emotion/react": ">=11",
    "@emotion/styled": ">=11",
    "@mui/icons-material": ">=7",
    "@mui/lab": ">=7",
    "@mui/material": ">=7",
    "@mui/x-date-pickers": "^9.5.0",
    "copy-to-clipboard": ">=3",
    "date-fns": ">=2",
    "dayjs": ">=1.11",
    "framer-motion": ">=12",
    "react": ">=18",
    "react-code-blocks": ">=0.1.6",
    "react-dom": ">=18",
    "react-router-dom": ">=7.5.0",
    "react-syntax-highlighter": ">=15.6",
    "react-virtuoso": ">=4",
    "sonner": ">=2",
    "use-debounce": ">=10",
    "zustand": ">=5"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.27.0",
    "@chromatic-com/storybook": "^5.1.2",
    "@faker-js/faker": "^10.4.0",
    "@prantlf/storycap": "^8.1.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.3",
    "@rollup/plugin-url": "^8.0.2",
    "@storybook/addon-docs": "10.3.5",
    "@storybook/addon-themes": "10.3.5",
    "@storybook/addon-vitest": "10.3.5",
    "@storybook/react-vite": "10.3.5",
    "@svgr/rollup": "^8.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.4.3",
    "@types/babel__core": "^7",
    "@types/identity-obj-proxy": "^3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.17",
    "@types/react-syntax-highlighter": "^15",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^10.0.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react": "^1.1.7",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.3.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "mockdate": "^3.0.5",
    "nodemon": "^3.1.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "prop-types": "^15.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "rollup": "^4.61.1",
    "rollup-plugin-circular-dependencies": "^2.0.1",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-clear": "^2.0.7",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-delete": "^3.0.1",
    "rollup-plugin-dts": "^6.2.1",
    "rollup-plugin-ignore": "^1.0.10",
    "rollup-plugin-node-builtins": "^2.1.2",
    "rollup-plugin-node-globals": "^1.4.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "storybook": "10.3.5",
    "ts-jest": "^29.4.11",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-transform-paths": "^4.0.0",
    "vite": "^8.0.16",
    "vite-plugin-imp": "^2.4.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.1.1",
    "@mui/lab": "^7.0.0-beta.10",
    "@mui/material": "^9.1.1",
    "@mui/system": "^9.1.1",
    "@mui/x-date-pickers": "^9.5.0",
    "copy-to-clipboard": "^4.0.2",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "framer-motion": "^12.6.2",
    "material-react-table": "^3.2.1",
    "react-code-blocks": "^0.1.6",
    "react-syntax-highlighter": "^16.1.1",
    "react-virtuoso": "^4.12.6",
    "recharts": "^3.8.1",
    "sonner": "^2.0.5",
    "use-debounce": "^10.0.4",
    "zustand": "^5.0.5"
  },
  "workspaces": [
    "scripts"
  ]
}
