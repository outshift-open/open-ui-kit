{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "lib:build": {
      "dependsOn": ["^lib:build"],
      "inputs": ["src/**", "rollup.config.*", "tsconfig*.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lib:dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["src/**", ".storybook/**", ".eslintrc.*", "tsconfig*.json"],
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^lib:build"],
      "inputs": ["src/**", ".storybook/**", "tsconfig*.json"],
      "outputs": []
    },
    "test": {
      "inputs": ["src/**", "jest.config.*", "tsconfig*.json"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false
    },
    "storybook": {
      "cache": false
    },
    "storybook:build": {
      "inputs": ["src/**", ".storybook/**"],
      "outputs": ["storybook-static/**"]
    },
    "license:add": {
      "cache": false,
      "outputs": []
    },
    "license:add:force": {
      "cache": false,
      "outputs": []
    },
    "license:check": {
      "cache": false,
      "outputs": []
    },
    "lint-staged": {},
    "banners": {
      "cache": false
    },
    "start": {
      "cache": false
    }
  }
}
